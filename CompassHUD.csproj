<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SPT 5.0 (EFT 1.0) is IL2CPP: plugins target BepInEx 6 IL2CPP on .NET and reference the
    interop assemblies BepInEx generates on first launch, not the game's Managed folder.
    Build with: dotnet build -c Release -p:GameDir="C:/path/to/SPT"
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>CompassHUD</AssemblyName>
    <Version>2.0.2</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">..\..\..</GameDir>
    <BepInExCore>$(GameDir)/BepInEx/core</BepInExCore>
    <Interop>$(GameDir)/BepInEx/interop</Interop>
  </PropertyGroup>

  <ItemGroup>
    <!-- Legacy Mono-era source kept for reference only. -->
    <Compile Remove="CompassHUD-1.0.0.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExCore)/BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExCore)/BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExCore)/Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(Interop)/Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(Interop)/Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(Interop)/Il2CppSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(Interop)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Diz.Binding">
      <HintPath>$(Interop)/Diz.Binding.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(Interop)/Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(Interop)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(Interop)/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(Interop)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(Interop)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(Interop)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Release zip laid out to extract straight into the SPT folder:
      dotnet build -c Release -p:GameDir="C:/path/to/SPT" -t:Package
  -->
  <Target Name="Package" DependsOnTargets="Build">
    <PropertyGroup>
      <PackageStaging>$(BaseIntermediateOutputPath)package/</PackageStaging>
      <PackageZip>$(OutDir)CompassHUD-$(Version)-SPT5.zip</PackageZip>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageStaging)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageStaging)BepInEx/plugins/CompassHUD" />
    <Copy SourceFiles="README.md;CHANGELOG.md;LICENSE.txt" DestinationFolder="$(PackageStaging)BepInEx/plugins/CompassHUD" />
    <Delete Files="$(PackageZip)" />
    <ZipDirectory SourceDirectory="$(PackageStaging)" DestinationFile="$(PackageZip)" />
    <Message Importance="high" Text="Release package: $(PackageZip)" />
  </Target>

</Project>
